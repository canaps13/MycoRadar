{
  "name": "mycoradar-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "node scripts/verify-map-bundle.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "test": "vitest run && node --test worker.test.mjs scripts/verify-map-bundle.test.mjs && npm run verify:map",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "prepare:map": "node scripts/prepare-map.ts",
    "verify:map": "node scripts/prepare-map.ts --verify"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@turf/bbox": "^7.4.0",
    "@turf/bbox-clip": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "polylabel": "^2.1.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
